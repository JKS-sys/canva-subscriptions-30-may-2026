{
  "name": "canva-tracker",
  "version": "1.0.0",
  "main": "electron-main.js",
  "description": "Secure Canva subscription tracker with Excel import/export",
  "author": "Jagadeesh Kumar S <JKS.sys@icloud.com>",
  "scripts": {
    "start": "node server.js",
    "electron": "electron ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "firebase-admin": "^11.10.1",
    "multer": "^1.4.5-lts.1",
    "xlsx": "latest"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^25.1.8",
    "electron-icon-maker": "^0.0.5"
  },
  "build": {
    "appId": "com.canva.tracker",
    "productName": "Canva Tracker",
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "public/**/*",
      ".env"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icons/mac/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/windows/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons/png/1024x1024.png"
    }
  }
}
